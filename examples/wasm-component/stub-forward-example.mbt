/// Example: how to fill in the wit-bindgen generated stub.
///
/// Run from the repo root:
///
///   wit-bindgen moonbit wit/mime.wit --out-dir wasm-component \
///     --derive-eq --derive-show --derive-error --project-name mooncampaign
///
/// Then edit the generated `wasm-component/gen/interface/mooncampaign/mime/
/// mime-builder/stub.mbt` (or equivalent path emitted by your wit-bindgen
/// version) to forward to the real implementation. This file shows the
/// forwarding code; type names are generated by wit-bindgen and may vary
/// slightly by version — adjust to the actual generated names.
///
/// The generated stub file is NOT checked in (it is a build artifact of
/// wit-bindgen); this example documents the one file you must hand-edit.

// ===== Generated by `wit-bindgen` 0.45.0. =====
// (These signatures are produced from wit/mime.wit. Field names in the
// generated structs are the WIT kebab-case converted to camelCase.)

/// Build a complete RFC 5322 MIME message (CRLF line endings).
pub fn build_message(msg : Message) -> String {
  // Forward to the mime package implementation.
  let mb = msg.from
  let m : @mime.Message = {
    from: { name: mb.name, email: mb.email },
    to: msg.to.map(fn(mb) -> @mime.Mailbox {
      { name: mb.name, email: mb.email }
    }),
    cc: msg.cc.map(fn(mb) -> @mime.Mailbox {
      { name: mb.name, email: mb.email }
    }),
    bcc: msg.bcc.map(fn(mb) -> @mime.Mailbox {
      { name: mb.name, email: mb.email }
    }),
    subject: msg.subject,
    date: msg.date,
    message_id: msg.message_id,
    text_body: msg.text_body,
    html_body: msg.html_body,
    attachments: msg.attachments.map(fn(a) -> @mime.Attachment {
      filename: a.filename,
      content_type: a.content_type,
      data: a.data,
    }),
    extra_headers: msg.extra_headers.map(fn(h) -> (String, String) {
      (h.name, h.value)
    }),
  }
  @mime.build_message(m)
}

/// RFC 4648 base64 encoder (no line wrapping; safe for encoded-words).
pub fn base64_encode(input : String) -> String {
  @mime.base64_encode_string(input)
}

/// RFC 2045 quoted-printable encoder (CRLF soft breaks).
pub fn quoted_printable_encode(input : String) -> String {
  @mime.quoted_printable_encode(input)
}

// ===== gen/moon.pkg (add after generation) =====
// import {
//   "mooncampaign/mime" @mime,
// }
// options(
//   link: {
//     "wasm": {
//       "exports": [
//         "cabi_realloc:cabi_realloc",
//         "wasmExportBuildMessage:mooncampaign/mime@0.1.0#build-message",
//         "wasmExportBase64Encode:mooncampaign/mime@0.1.0#base64-encode",
//         "wasmExportQuotedPrintableEncode:mooncampaign/mime@0.1.0#quoted-printable-encode",
//       ],
//       "export-memory-name": "memory",
//       "heap-start-address": 16,
//     },
//   },
// )
//
// ===== Build =====
//   moon build --target wasm
//   wasm-tools component embed wit _build/wasm/release/build/gen/gen.wasm \
//     --encoding utf16 --output mime.wasm
//   wasm-tools component new mime.wasm --output mime.component.wasm
//
// ===== Verify the component interface =====
//   wasm-tools component wit mime.component.wasm
//
// ===== Test with Wasmtime =====
//   wasmtime run --invoke 'build-message' mime.component.wasm
//   wasmtime run --invoke 'base64-encode("Hello")' mime.component.wasm
//   # expected: SGVsbG8=
